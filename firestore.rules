rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles collection
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Field Jobs & Dispatch collection
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
    }

    // Invoices & Billing collection
    match /invoices/{invoiceId} {
      allow read, write: if request.auth != null;
    }

    // Default rule for authenticated field service personnel
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
